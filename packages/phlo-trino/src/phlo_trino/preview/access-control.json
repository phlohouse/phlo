{
  "catalogs": [
    {
      "user": "phlo_api_preview_prod",
      "catalog": "iceberg_preview_prod",
      "allow": "read-only"
    },
    {
      "user": "phlo_api_preview_staging",
      "catalog": "iceberg_preview_staging",
      "allow": "read-only"
    },
    {
      "user": "phlo_api_preview_(prod|staging)",
      "catalog": ".*",
      "allow": "none"
    },
    {
      "catalog": ".*",
      "allow": "all"
    }
  ],
  "system_session_properties": [
    {
      "user": "phlo_api_preview_(prod|staging)",
      "allow": false
    },
    {
      "allow": true
    }
  ],
  "queries": [
    {
      "user": "phlo_api_preview_(prod|staging)",
      "allow": ["execute"]
    },
    {
      "allow": ["execute"]
    }
  ]
}
