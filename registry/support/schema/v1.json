{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.phlohouse.com/schema/support/v1.json",
  "title": "Phlo v1 support boundary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "manifest_schema",
    "schema_version",
    "release_line",
    "artifact_pinning",
    "profiles",
    "packages",
    "services",
    "capabilities",
    "gates",
    "current_release",
    "runtime",
    "production",
    "release_set",
    "exclusions"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "manifest_schema": { "const": "phlo.support.v1" },
    "schema_version": { "const": "1.0" },
    "release_line": { "const": "1.x" },
    "artifact_pinning": { "const": "not_yet_published" },
    "profiles": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/profile" }
    },
    "packages": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    },
    "services": {
      "type": "array",
      "items": { "$ref": "#/$defs/service" }
    },
    "capabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/capability" }
    },
    "gates": { "$ref": "#/$defs/gates" },
    "current_release": { "$ref": "#/$defs/current_release" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "production": { "$ref": "#/$defs/production" },
    "release_set": { "$ref": "#/$defs/release_set" },
    "exclusions": {
      "type": "array",
      "items": { "$ref": "#/$defs/exclusion" }
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": [
        "supported",
        "required",
        "preview",
        "experimental",
        "development_only",
        "planned",
        "excluded"
      ]
    },
    "maturity": {
      "type": "string",
      "enum": ["alpha", "preview", "development_only", "planned", "blocked", "unverified"]
    },
    "scope": {
      "type": "string",
      "enum": ["blessed_core", "optional", "outside_v1"]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "scope", "target_status", "current_maturity", "reason", "evidence"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "scope": { "$ref": "#/$defs/scope" },
        "target_status": { "$ref": "#/$defs/status" },
        "current_maturity": { "$ref": "#/$defs/maturity" },
        "reason": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "package",
        "source",
        "scope",
        "target_status",
        "current_maturity",
        "reason",
        "evidence"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "package": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "scope": { "$ref": "#/$defs/scope" },
        "target_status": { "$ref": "#/$defs/status" },
        "current_maturity": { "$ref": "#/$defs/maturity" },
        "reason": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "components", "reason"],
      "properties": {
        "status": { "type": "string", "minLength": 1 },
        "components": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "scope", "target_status", "current_maturity", "reason", "evidence"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "scope": { "$ref": "#/$defs/scope" },
        "target_status": { "$ref": "#/$defs/status" },
        "current_maturity": { "$ref": "#/$defs/maturity" },
        "reason": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "os", "containers"],
      "properties": {
        "python": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "supported", "advertised_unverified", "unverified", "reason", "evidence"],
          "properties": {
            "minimum": { "const": "3.12" },
            "supported": { "type": "array", "items": { "type": "string" } },
            "advertised_unverified": { "type": "array", "items": { "type": "string" } },
            "unverified": { "type": "array", "items": { "type": "string" } },
            "reason": { "type": "string", "minLength": 1 },
            "evidence": { "$ref": "#/$defs/evidence" }
          }
        },
        "os": {
          "type": "object",
          "additionalProperties": false,
          "required": ["supported", "tested", "unverified", "reason", "evidence"],
          "properties": {
            "supported": { "type": "array", "items": { "type": "string" } },
            "tested": { "type": "array", "items": { "type": "string" } },
            "unverified": { "type": "array", "items": { "type": "string" } },
            "reason": { "type": "string", "minLength": 1 },
            "evidence": { "$ref": "#/$defs/evidence" }
          }
        },
        "containers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["supported", "unverified", "reason", "evidence"],
          "properties": {
            "supported": { "type": "array", "items": { "type": "string" } },
            "unverified": { "type": "array", "items": { "type": "string" } },
            "reason": { "type": "string", "minLength": 1 },
            "evidence": { "$ref": "#/$defs/evidence" }
          }
        }
      }
    },
    "production": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "requirements",
        "development_defaults",
        "reason",
        "release_cut_note",
        "evidence"
      ],
      "properties": {
        "status": { "type": "string", "enum": ["blocked", "required_before_release"] },
        "requirements": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "development_defaults": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "reason": { "type": "string", "minLength": 1 },
        "release_cut_note": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status", "components"],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "status": {
          "type": "object",
          "additionalProperties": false,
          "required": ["security", "run_evidence", "maintenance", "upgrade_restore", "golden_path"],
          "properties": {
            "security": { "$ref": "#/$defs/gate_state" },
            "run_evidence": { "$ref": "#/$defs/gate_state" },
            "maintenance": { "$ref": "#/$defs/gate_state" },
            "upgrade_restore": { "$ref": "#/$defs/gate_state" },
            "golden_path": { "$ref": "#/$defs/gate_state" }
          }
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status", "applicable_gates", "blocked_by"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "status": { "$ref": "#/$defs/gate_state" },
              "applicable_gates": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "blocked_by": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "evidence": { "$ref": "#/$defs/evidence" }
            }
          }
        }
      }
    },
    "gate_state": {
      "type": "string",
      "enum": ["blocked", "planned", "passed", "not_required"]
    },
    "current_release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "maturity", "production_ready"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "maturity": { "const": "alpha" },
        "production_ready": { "const": false }
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "reason", "evidence"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "status": { "const": "excluded" },
        "reason": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "release_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packages", "services", "schemas"],
      "properties": {
        "packages": {
          "type": "array",
          "items": { "$ref": "#/$defs/release_package" }
        },
        "services": {
          "type": "array",
          "items": { "$ref": "#/$defs/release_service" }
        },
        "schemas": { "$ref": "#/$defs/release_schemas" }
      }
    },
    "release_package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "release_service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "image_reference"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "image_reference": { "type": "string", "minLength": 1 }
      }
    },
    "release_schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configuration", "database"],
      "properties": {
        "configuration": { "$ref": "#/$defs/versioned_schema" },
        "database": { "$ref": "#/$defs/versioned_schema" }
      }
    },
    "versioned_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    }
  }
}
